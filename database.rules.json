{
  "rules": {
    ".read": false,
    ".write": false,
    "tempo": {
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
          "events": {
            "$eventId": {
              ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
              ".validate": "$eventId.matches(/^[a-zA-Z0-9_-]{1,100}$/) && newData.hasChildren(['day','title','start','end','cat']) && newData.child('end').val() > newData.child('start').val()",
              "day": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4 && newData.val() % 1 === 0"
              },
              "title": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
              },
              "start": {
                ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
              },
              "end": {
                ".validate": "newData.isString() && newData.val().matches(/^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$/)"
              },
              "cat": {
                ".validate": "newData.isString() && newData.val().matches(/^(str|cardio|jp|work|commute|life|rest)$/)"
              },
              "note": {
                ".validate": "newData.isString() && newData.val().length <= 300"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "days": {
            "$date": {
              ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous' && newData.exists()",
              ".validate": "$date.matches(/^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/) && newData.hasChild('updatedAt')",
              "items": {
                "str": {
                  ".validate": "newData.isBoolean()"
                },
                "run": {
                  ".validate": "newData.isBoolean()"
                },
                "diet": {
                  ".validate": "newData.isBoolean()"
                },
                "steps": {
                  ".validate": "newData.isBoolean()"
                },
                "jp": {
                  ".validate": "newData.isBoolean()"
                },
                "sleep": {
                  ".validate": "newData.isBoolean()"
                },
                "$other": {
                  ".validate": false
                },
                ".validate": "newData.hasChildren()"
              },
              "weight": {
                ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 200"
              },
              "breakfast": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              },
              "lunch": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              },
              "snack": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              },
              "dinner": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              },
              "updatedAt": {
                ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() > 0"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "meta": {
            "initialized": {
              ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous' && newData.val() === true",
              ".validate": "newData.val() === true"
            }
          }
        }
      }
    }
  }
}
