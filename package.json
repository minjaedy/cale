{
  "name": "tempo-routine",
  "version": "1.0.0",
  "private": true,
  "description": "TEMPO — iPhone-first routine calendar with Firebase Realtime Database",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/sync-core.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-tempo --only database \"node --test tests/database.rules.test.mjs\"",
    "deploy:rules": "firebase deploy --only database --project cale-b2c40",
    "deploy": "npm run build && firebase deploy --only hosting,database --project cale-b2c40"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.33.0"
  }
}
